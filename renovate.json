{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/docker/Dockerfile\\.acceptance-test\\.multistage/"
      ],
      "matchStrings": [
        "FROM mcr\\.microsoft\\.com/playwright:v(?<currentValue>\\d+\\.\\d+\\.\\d+)-\\w+"
      ],
      "depNameTemplate": "com.microsoft.playwright:playwright",
      "datasourceTemplate": "maven"
    }
  ],
  "packageRules": [
    {
      "groupName": "quarkus",
      "matchPackageNames": [
        "/^io\\.quarkus/",
        "/^quarkus/"
      ]
    },
    {
      "groupName": "quarkiverse",
      "matchPackageNames": [
        "/^io\\.quarkiverse/"
      ]
    },
    {
      "groupName": "mvnpm",
      "matchPackageNames": [
        "/^org\\.mvnpm/",
        "!org.mvnpm:react",
        "!org.mvnpm:react-dom",
        "!org.mvnpm:react-bootstrap",
        "!org.mvnpm:classnames",
        "!org.mvnpm:hooks",
        "!org.mvnpm.at.types:react",
        "!org.mvnpm:styled-components"
      ]
    },
    {
      "groupName": "playwright",
      "matchPackageNames": [
        "/^com\\.microsoft\\.playwright/"
      ]
    },
    {
      "description": "Disable built-in dockerfile manager for playwright (managed by custom regex to sync with Maven version)",
      "matchPackageNames": ["mcr.microsoft.com/playwright"],
      "matchManagers": ["dockerfile"],
      "enabled": false
    },
    {
      "description": "Block major updates for web deps (transitive deps controlled by upstream libraries)",
      "matchPackageNames": [
        "/^org\\.mvnpm/"
      ],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "Block minor updates for react-bootstrap compat-sensitive deps",
      "matchPackageNames": [
        "org.mvnpm:react",
        "org.mvnpm:react-dom",
        "org.mvnpm:react-bootstrap",
        "org.mvnpm:classnames",
        "org.mvnpm:hooks",
        "org.mvnpm.at.types:react",
        "org.mvnpm:styled-components"
      ],
      "matchUpdateTypes": ["minor"],
      "enabled": false
    }
  ]
}
